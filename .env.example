# Personal access token from Konnect (Organization -> Personal Access Tokens).
# Required for the API suite. The value starts with kpat_.
KONNECT_PAT=

# Konnect region. Defaults to US if unset.
# https://us.api.konghq.com | https://eu.api.konghq.com | https://au.api.konghq.com
KONNECT_BASE_URL=https://us.api.konghq.com

# Only needed for the optional UI login test, which is skipped without them.
KONNECT_USERNAME=
KONNECT_PASSWORD=

# Leave the API created by a run in place instead of deleting it in teardown.
KEEP_TEST_DATA=false

# Last resort for networks that intercept TLS. Prefer NODE_OPTIONS=--use-system-ca,
# see the "Corporate networks" section of the README.
KONNECT_IGNORE_HTTPS_ERRORS=false
